<script>
const STORE='nucleo-lab-aportes-v1';
const $=id=>document.getElementById(id);
const getData=()=>{try{return JSON.parse(localStorage.getItem(STORE)||'[]')}catch(e){return []}};
const saveData=d=>localStorage.setItem(STORE,JSON.stringify(d));
const languages=[...document.querySelectorAll('input[name="language"]')];
languages.forEach(el=>el.addEventListener('change',()=>{
 const checked=languages.filter(x=>x.checked);
 if(checked.length>3){el.checked=false;$('languageCount').textContent='Puedes elegir máximo 3 lenguajes.';return}
 $('languageCount').textContent=`${checked.length} de 3 seleccionados.`;
}));
$('participantForm').addEventListener('submit',e=>{
 e.preventDefault();
 const selected=languages.filter(x=>x.checked).map(x=>x.value);
 if(!selected.length){$('formStatus').textContent='Selecciona al menos un lenguaje creativo para continuar.';return}
 const record={id:Date.now(),alias:$('alias').value.trim(),role:$('role').value,languages:selected,themes:$('themes').value.trim(),memory:$('memory').value.trim(),wish:$('wish').value.trim(),resources:$('resources').value.trim(),createdAt:new Date().toISOString()};
 const all=getData();all.push(record);saveData(all);
 $('formStatus').textContent='¡Gracias! Tu aporte quedó guardado en este navegador. Para compartirlo con otros dispositivos hace falta activar la base de datos común.';
 $('participantForm').reset();$('languageCount').textContent='0 de 3 seleccionados.';renderMap();
});
$('clearForm').addEventListener('click',()=>{$('participantForm').reset();$('languageCount').textContent='0 de 3 seleccionados.';$('formStatus').textContent='Ficha limpia.'});
function renderMap(){
 const data=getData(),counts={};let themeCount=0;const themeText=[];
 data.forEach(r=>{(r.languages||[]).forEach(l=>counts[l]=(counts[l]||0)+1);if(r.themes){themeCount++;themeText.push(...r.themes.split(/[,;.\n]/).map(s=>s.trim()).filter(s=>s.length>2))}});
 $('totalCount').textContent=data.length;$('languageTotal').textContent=Object.keys(counts).length;$('themeTotal').textContent=themeCount;
 const sorted=Object.entries(counts).sort((a,b)=>b[1]-a[1]);
 $('languageBars').innerHTML=sorted.length?sorted.map(([name,n])=>`<div class="barrow"><span>${esc(name)}</span><div class="bar"><i style="width:${Math.max(6,n/Math.max(...sorted.map(x=>x[1]))*100)}%"></i></div><b>${n}</b></div>`).join(''):'<p class="small">Cuando haya respuestas, aparecerán aquí las afinidades del grupo.</p>';
 const words={};themeText.forEach(t=>{const k=t.toLocaleLowerCase('es');words[k]=(words[k]||0)+1});
 const top=Object.entries(words).sort((a,b)=>b[1]-a[1]).slice(0,12);
 $('themeTags').innerHTML=top.length?top.map(([t,n])=>`<span class="tag ${n>1?'purple':''}">${esc(t)}${n>1?' · '+n:''}</span>`).join(''):'<span class="tag">Aún no hay temas escritos</span>';
}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
$('refreshMap').addEventListener('click',renderMap);
$('clearAll').addEventListener('click',()=>{if(confirm('¿Borrar todos los aportes guardados en este navegador? Esta acción no se puede deshacer.')){localStorage.removeItem(STORE);renderMap()}});
function download(filename,text,type){const blob=new Blob([text],{type});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click();URL.revokeObjectURL(a.href)}
